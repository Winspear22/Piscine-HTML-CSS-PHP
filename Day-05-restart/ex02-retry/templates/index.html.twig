{% extends 'base.html.twig' %}
{% block title %}Ajouter une personne (ex02){% endblock %}

{% block body %}
    {# Messages flash de succès/erreur #}
    {% for msg in app.flashes('notice') %}
        <div class="alert">{{ msg }}</div>
    {% endfor %}

    <div class="form-wrapper">
        <h1>Ajouter une personne</h1>
        {{ form(form) }}
        <h2>Liste des personnes</h2>

    </div>


    <table>
        <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Name</th>
            <th>Email</th>
            <th>Enable</th>
            <th>Birthdate</th>
            <th>Address</th>
        </tr>
        {% for person in persons %}
            <tr>
                <td>{{ person.id }}</td>
                <td>{{ person.username }}</td>
                <td>{{ person.name }}</td>
                <td>{{ person.email }}</td>
                <td>{{ person.enable ? 'Oui' : 'Non' }}</td>
                <td>{{ person.birthdate }}</td>
                <td>{{ person.address }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7" style="text-align: center;">Aucune personne enregistrée.</td>
            </tr>
        {% endfor %}
    </table>
{% endblock %}
