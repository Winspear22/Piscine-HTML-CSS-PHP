{% extends 'base.html.twig' %}
{% block title %}Ajouter un utilisateur{% endblock %}
{% block body %}
	<h1>Créer la table {{ tableName }}</h1>

    {# Affiche le message flash notice s’il existe #}
    {% for msg in app.flashes('notice') %}
        <div class="alert">{{ msg }}</div>
    {% endfor %}

	<form method="post" action="{{ path('ex00_index') }}">
		<button type="submit">Créer la table</button>
	</form>
{% endblock %}
