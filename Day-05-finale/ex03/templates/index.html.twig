{% extends 'base.html.twig' %}

{% block title %}Utilisateurs (ex03){% endblock %}

{% block body %}
    <h1>Ajouter un utilisateur</h1>
    {% for msg in app.flashes('success') %}
        <div class="alert success">{{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="alert error">{{ msg }}</div>
    {% endfor %}

    <div class="form-wrapper">
        {{ form(form) }}
    </div>

    <h2>Liste des utilisateurs</h2>
    {% if users|length > 0 %}
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Enable</th>
                    <th>Birthdate</th>
                    <th>Address</th>
                </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.username }}</td>
                    <td>{{ user.name }}</td>
                    <td>{{ user.email }}</td>
                    <td>{{ user.enable ? 'Oui' : 'Non' }}</td>
                    <td>{{ user.birthdate ? user.birthdate|date('d/m/Y') : '' }}</td>
                    <td>{{ user.address }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>Aucun utilisateur pour l'instant.</p>
    {% endif %}
{% endblock %}
