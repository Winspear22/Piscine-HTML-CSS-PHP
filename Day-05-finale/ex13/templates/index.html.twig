{% extends 'base.html.twig' %}

{% block title %}Liste des employés{% endblock %}

{% block body %}
    <h1>Liste des employés</h1>

    {# Affichage des messages flash #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <div style="margin-bottom: 1.5em;">
        <a href="{{ path('ex13_create') }}" class="back-btn">+ Nouvel employé</a>
    </div>

    <table>
        <thead>
            <tr>
                <th>Prénom</th>
                <th>Nom</th>
                <th>Email</th>
                <th>Date de naissance</th>
                <th>Actif</th>
                <th>Date d'embauche</th>
                <th>Date de fin</th>
                <th>Heures</th>
                <th>Salaire</th>
                <th>Poste</th>
                <th>Manager</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for employee in employees %}
            <tr>
                <td>{{ employee.firstname }}</td>
                <td>{{ employee.lastname }}</td>
                <td>{{ employee.email }}</td>
                <td>{{ employee.birthdate|date('d/m/Y') }}</td>
                <td>{{ employee.active ? 'Oui' : 'Non' }}</td>
                <td>{{ employee.employedSince|date('d/m/Y') }}</td>
                <td>
                    {% if employee.employedUntil %}
                        {{ employee.employedUntil|date('d/m/Y') }}
                    {% else %}
                        <span style="color:#888;">-</span>
                    {% endif %}
                </td>
                <td>{{ employee.hours.value }}</td>
                <td>{{ employee.salary }}</td>
                <td>{{ employee.position.value }}</td>
                <td>
                    {% if employee.manager %}
                        {{ employee.manager.firstname }} {{ employee.manager.lastname }}
                    {% else %}
                        <span style="color:#888;">-</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('ex13_index', {id: employee.id}) }}">Voir</a> |
                    <a href="{{ path('ex13_update', {id: employee.id}) }}">Modifier</a> |
                    <form method="post" action="{{ path('ex13_delete', {id: employee.id}) }}" style="display:inline;" onsubmit="return confirm('Confirmer la suppression ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ employee.id) }}">
                        <button type="submit" style="background:none; border:none; color:#b00; cursor:pointer; font-weight:bold;">Supprimer</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="12" style="text-align:center;color:#888;">Aucun employé enregistré.</td></tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
