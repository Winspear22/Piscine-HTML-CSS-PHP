{% extends 'base.html.twig' %}

{% block title %}Détail de l'employé{% endblock %}

{% block body %}
    <h1>Détail de l'employé</h1>

    <table>
        <tr><th>Prénom</th><td>{{ employee.firstname }}</td></tr>
        <tr><th>Nom</th><td>{{ employee.lastname }}</td></tr>
        <tr><th>Email</th><td>{{ employee.email }}</td></tr>
        <tr><th>Date de naissance</th><td>{{ employee.birthdate|date('d/m/Y') }}</td></tr>
        <tr><th>Actif</th><td>{{ employee.active ? 'Oui' : 'Non' }}</td></tr>
        <tr><th>Date d'embauche</th><td>{{ employee.employedSince|date('d/m/Y') }}</td></tr>
        <tr><th>Date de fin</th>
            <td>
                {% if employee.employedUntil %}
                    {{ employee.employedUntil|date('d/m/Y') }}
                {% else %}
                    <span style="color:#888;">-</span>
                {% endif %}
            </td>
        </tr>
        <tr><th>Heures</th><td>{{ employee.hours.value }}</td></tr>
        <tr><th>Salaire</th><td>{{ employee.salary }}</td></tr>
        <tr><th>Poste</th><td>{{ employee.position.value }}</td></tr>
        <tr><th>Manager</th>
            <td>
                {% if employee.manager %}
                    {{ employee.manager.firstname }} {{ employee.manager.lastname }}
                {% else %}
                    <span style="color:#888;">-</span>
                {% endif %}
            </td>
        </tr>
    </table>

    <div style="margin-top:2em;">
        <a href="{{ path('ex13_index') }}" class="back-btn">Retour à la liste</a>
        <a href="{{ path('ex13_update', {id: employee.id}) }}" class="back-btn">Modifier</a>
    </div>
{% endblock %}
