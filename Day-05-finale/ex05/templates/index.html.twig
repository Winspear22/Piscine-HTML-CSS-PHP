{% extends 'base.html.twig' %}

{% block title %}Ex05 — ORM CRUD{% endblock %}

{% block body %}
<h1>Ex05 — Génération et suppression d'utilisateurs (ORM)</h1>

{# Affiche les messages flash #}
{% for msg in app.flashes('success') %}
    <div class="alert">{{ msg }}</div>
{% endfor %}
{% for msg in app.flashes('error') %}
    <div class="alert error">{{ msg }}</div>
{% endfor %}

{# Bouton pour créer 10 utilisateurs #}
<form method="post" action="{{ path('ex05_create') }}">
    <button type="submit">Créer 10 utilisateurs</button>
</form>

<h2>Liste des utilisateurs</h2>
<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Nom</th>
            <th>Email</th>
            <th>Actif</th>
            <th>Date de naissance</th>
            <th>Adresse</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
    {% for user in users %}
        <tr>
            <td>{{ user.id }}</td>
            <td>{{ user.username }}</td>
            <td>{{ user.name }}</td>
            <td>{{ user.email }}</td>
            <td>{{ user.enable ? 'Oui' : 'Non' }}</td>
            <td>{{ user.birthdate ? user.birthdate|date('Y-m-d') : '' }}</td>
            <td>{{ user.address }}</td>
            <td>
                <form method="post" action="{{ path('ex05_delete', {id: user.id}) }}" style="display:inline;">
                    <button type="submit" onclick="return confirm('Supprimer cet utilisateur ?');">Supprimer</button>
                </form>
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="8" style="text-align: center;">Aucun utilisateur.</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
