{% extends 'base.html.twig' %}

{% block title %}Ex04 - Supprimer un user {% endblock %}

{% block body %}
    <h1>Suppression des users</h1>

    {# Affiche les messages flash (succès/erreur) #}
    {% for msg in app.flashes('notice') %}
        <div class="alert">{{ msg }}</div>
    {% endfor %} 

    <h2>Liste des users</h2>
    <table>
        <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Name</th>
            <th>Email</th>
            <th>Enable</th>
            <th>Birthdate</th>
            <th>Address</th>
            <th>Action</th>
        </tr>
		{% for user in users %}
		<tr>
			<td>{{ user.id }}</td>
				<td>{{ user.username }}</td>
				<td>{{ user.name }}</td>
				<td>{{ user.email }}</td>
				<td>{{ user.enable ? 'Oui' : 'Non' }}</td>
				<td>{{ user.birthdate|date('Y-m-d') }}</td>
				<td>{{ user.address }}</td>
				<td>
					{# Formulaire pour suppression #}
					<form method="post" action="{{ path('ex04_delete', {id: user.id}) }}" style="display:inline;">
						<button type="submit" onclick="return confirm('Confirmer la suppression ?')">Supprimer</button>
					</form>
				</td>
			</tr>
		{% else %}
			<tr>
				<td colspan="8" style="text-align: center;">Aucune user enregistrée.</td>
			</tr>
		{% endfor %}
			<form action="{{ path('ex04_fill') }}" method="post" style="display: inline;">
				<button type="submit">Remplir la table avec 10 users</button>
			</form>

{% endblock %}