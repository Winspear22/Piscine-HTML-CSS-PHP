{% extends 'base.html.twig' %}

{% block title %}Ajouter un compte bancaire{% endblock %}

{% block body %}
    <h1>Ajouter un compte bancaire à {{ person.name }}</h1>
    {% for msg in app.flashes('success') %}
        <div class="alert">{{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="alert error">{{ msg }}</div>
    {% endfor %}

    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit" class="btn">Ajouter</button>
    {{ form_end(form) }}

    <a href="{{ path('ex09_index') }}" class="btn">Retour à la liste</a>
{% endblock %}
