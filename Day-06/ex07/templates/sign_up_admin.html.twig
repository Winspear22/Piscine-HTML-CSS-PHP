{% extends 'base.html.twig' %}

{% block title %}Créer un compte ADMINISTRATEUR{% endblock %}

{% block body %}
<h1>Créer un compte ADMINISTRATEUR</h1>

{{ form_start(registrationFormAdmin) }}
    {{ form_row(registrationFormAdmin.username) }}
    {{ form_row(registrationFormAdmin.plainPassword, {
        label: 'Mot de passe'
    }) }}
    <button type="submit" class="btn btn-primary">Créer le compte</button>
{{ form_end(registrationFormAdmin) }}

<a href="{{ path('e07_index') }}" class="btn btn-secondary mt-3">Retour à l’accueil</a>
{% endblock %}
