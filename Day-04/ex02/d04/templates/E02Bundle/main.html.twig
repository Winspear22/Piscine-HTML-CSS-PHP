{% extends 'base2.html.twig' %}

{% block body %}

{{ form_start(form) }}
<div = class="form">
	<div class="form-control">
		<i class="form-text"></i> {{ form_label(form.Text) }}
		{{ form_widget(form.Text) }}

		<small>{{ form_help(form.Text) }}</small>

		<div class="form-error">
			{{ form_errors(form.Text) }}
		</div>
	</div>

	<div class="form-control">
		<i class="form-isDated"></i> {{ form_label(form.IsDated) }}
		{{ form_widget(form.IsDated) }}

		<small>{{ form_help(form.IsDated) }}</small>

		<div class="form-error">
			{{ form_errors(form.IsDated) }}
		</div>
	</div>
</div>
{{ form_end(form) }}
{% endblock %}

